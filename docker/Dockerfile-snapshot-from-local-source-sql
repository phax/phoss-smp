# Use an official Tomcat runtime as a base image
FROM tomcat:10.1-jre25

# Block the compromised eMudhra intermediate CA certificates (16 certificates, including the
# ones cross-signed by Sectigo AAA), see https://github.com/phax/phoss-ap/issues/115
# Source: https://emudhra.we-have-a-problem.com/impacted-intermediates.json
# The hashes are appended to the JDK "blocked.certs" file. This is idempotent, so it stays
# harmless once the base image ships a JDK that already blocks them.
RUN BLOCKED="$JAVA_HOME/lib/security/blocked.certs" && \
    grep -q 42C4ACCD12C4F59597925E1A08A7A90102608543809308D50EC427E118BA1493 "$BLOCKED" || \
      { echo >> "$BLOCKED" && \
        printf '%s\n' \
          '# eMudhra compromised intermediate CAs (disclosed 2026-10-20)' \
          '42C4ACCD12C4F59597925E1A08A7A90102608543809308D50EC427E118BA1493' \
          '45A883F349AEDFD5F3A649B5498FFB121712BA8B448F3F2A91DBC5A766FCDDBE' \
          '98B896625C0C230ADEEC3EB2CF6AAD5001ECF9156A68644E82374CE5833BC25B' \
          '5F1DED4DD590AF74631290CF073B122A2AAC6A1FA479778A0BD43579BD832699' \
          'E7568FE6E12331F4FD7DE61DA4C7559D0F8EB192A218D4741A3BA75184333838' \
          '579480AEA166290BD3C643589E795FC0D0E54E86505D180F1DFF99EFD3199512' \
          '0164D7CEAE5BB909C272AF151FF44B1177AE9B47D9424B94F1D9558C30934D19' \
          '62B7F9868263F72F6911FC78CEAF72C1979158B7368BF648683BB2AA39B02E72' \
          'CB6E15165AC802E9B3F993F16C25D41F4E81C21EBDE71AE1B012AC00BF9C7C3F' \
          '7485B51C0ED192878FA1D2F948FB529AE1842CC5086C4B67F7BE5B2039DE9489' \
          '432EC25F0D28DE9006D97BF752F17BBB2CD41F669933FCB072D9A1148D0261F3' \
          'FD9D5C2DBBD4995AB69B8D50C439D9527B00529199C2FD01B2174EB58F07021F' \
          '9E39DE2881273ACC225A149C72BA3E0F51424963669AB633EE1DC7DF5DB067B4' \
          'A496E23AC0CAB8155FC9B117B97EAE368EFCBB9041AEC8804D5A308D2D01C2D8' \
          '4B2460A466F95FD40113BCDCCA2CEB29B3B093921DE45474DA7DF48874C630B1' \
          '84112972B8E59D14560AE7E7119654474AAD119990CF3722BFC1E3B91615E1FD' >> "$BLOCKED"; }

# Use non-blocking random
ENV CATALINA_OPTS="--enable-native-access=ALL-UNNAMED -Djava.security.egd=file:/dev/urandom -Dorg.apache.catalina.session.StandardSession.ACTIVITY_CHECK=true"

# MinRAMPercentage - for low memory containers (<250MB)
# MaxRAMPercentage - for large memory containers (>250MB)
# See: https://medium.com/pernod-ricard-tech/how-to-control-java-memory-in-tomcat-running-on-docker-cec267f858d4
ENV CATALINA_OPTS="$CATALINA_OPTS -XX:InitialRAMPercentage=10 -XX:MinRAMPercentage=50 -XX:MaxRAMPercentage=80"

LABEL vendor="Philip Helger"
LABEL version="HEAD"

# Install vim etc.
RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y vim inetutils-ping telnet \
  && rm -rf /var/lib/apt/lists/*
  
  # Copy result to Tomcat webapps dir
COPY phoss-smp-webapp-sql/target/phoss-smp-webapp-sql-*/ $CATALINA_HOME/webapps/ROOT

# Checkout from git and build
WORKDIR /home/git
